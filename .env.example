# Copy to .env and fill in the keys for the providers you use.
# Model calls go through litellm; see https://docs.litellm.ai/docs/providers for other providers.

# Judge (default: gemini/gemini-3.1-flash-lite-preview)
GEMINI_API_KEY=

# OpenAI models, e.g. --model gpt-5-mini
OPENAI_API_KEY=

# Hugging Face token for gated tokenizers / models (optional)
HF_TOKEN=
